# SKL_AGENT Master Template Gitignore
# Bỏ qua mọi dữ liệu phát sinh của User, chỉ duy trì Template hệ thống.

# OS generated files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local

# Data Pipeline Structure (Do not commit user data)
1_input/
2_process/
3_output/

# App Development Structure (Do not commit user source code)
src/
docs/*
!docs/skill_extension_integration_guide.md
tests/
dist/
build/
node_modules/
__pycache__/
*.pyc

# IDEs
.vscode/
.idea/
.cursor/

# Agent History & Logs
.agents/logs/
.agents/history/
.agents/cache/
.bot.lock
.antigravity/

# SQLite databases
*.db
*.sqlite3
